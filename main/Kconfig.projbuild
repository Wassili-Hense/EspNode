menu "EspNode"

    menu "MQTT-SN serial link"
        comment "Used when the cfg partition is missing or invalid"

        config ESPNODE_UART_PORT
            int "UART port"
            range 0 2
            default 0
            help
                UART0 is the USB port of devkits: the console is off (sdkconfig.defaults).
                For debugging with the console on UART0 choose UART1 or UART2.

        config ESPNODE_UART_TX_PIN
            int "TX GPIO"
            range 0 33
            default 1
            help
                On WROVER modules GPIO16/17 are used by PSRAM, choose other pins.

        config ESPNODE_UART_RX_PIN
            int "RX GPIO"
            range 0 39
            default 3

        config ESPNODE_UART_DE_PIN
            int "RS485 DE GPIO (-1 = plain UART)"
            range -1 33
            default -1
            help
                Driver enable of an RS485 transceiver (half duplex), DE and /RE tied together.

        config ESPNODE_UART_BAUD
            int "Baud rate"
            default 38400

    endmenu

    config ESPNODE_HW_VERSION
        string "Hardware version"
        default "10"
        help
            Last two characters of the X13 declarer (device type). The declarer is
            "E1" (uC family E - ESP32, subtype 1) + PHY letters of the interfaces + this version.

    config ESPNODE_SW_VERSION
        string "Software version"
        default "400"

endmenu
